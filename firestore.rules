rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Block client-side role escalation
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId 
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if hasRole('admin');
    }

    // --- Doctors Collection ---
    match /doctors/{doctorId} {
      allow read: if true; // Public directory search
      allow create, delete: if hasRole('admin');
      // Doctors can only modify their own slots array
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid 
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots']))
                    || hasRole('admin');
    }

    // --- Hospitals Collection ---
    match /hospitals/{hospitalId} {
      allow read: if true; // Public bed tracker
      allow create, delete: if hasRole('admin');
      // Hospital staff can update telemetry & details
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid)
                    || hasRole('admin');
    }

    // --- Blood Banks Collection ---
    match /bloodbanks/{bankId} {
      allow read: if true; // Public stock search
      allow create, delete: if hasRole('admin');
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid)
                    || hasRole('admin');
    }

    match /blood_banks/{bankId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // --- Appointments Collection ---
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        hasRole('admin')
      );
      // Raw client writes are blocked (must use transactional Cloud Function)
      allow create: if isAuthenticated() && request.resource.data.patientId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.doctorId == request.auth.uid ||
        hasRole('admin')
      );
      allow delete: if hasRole('admin');
    }
  }
}